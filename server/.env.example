# Vision360 API — environment.
# Copy to server/.env for LOCAL development (never commit .env).
# For PRODUCTION set the same DATABASE_URL in the Vercel project's
# Settings → Environment Variables (see DEPLOY.md).

# Postgres connection string.
#  • Local Postgres:  postgresql://postgres:YOUR_PASSWORD@localhost:5432/vision360
#  • Neon / Vercel Postgres / Supabase: copy the "pooled" connection string they give you.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/vision360

# TLS is auto-enabled for any non-local host, so you normally don't need this.
# Force it on/off only if your provider needs an override.
# PGSSL=true

# Port for the standalone dev API (npm run server). Ignored on Vercel.
# PORT=4000
