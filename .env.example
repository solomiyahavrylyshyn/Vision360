# ── Vision360 data layer ──────────────────────────────────────────────
# Copy this file to ".env" and fill in YOUR local Postgres password.
# (.env is git-ignored and never committed.)
#
# First create the database once, e.g. in psql / pgAdmin:
#     CREATE DATABASE vision360;
#
# Then set the connection string (note: a password is required — the server
# detected Postgres listening on localhost:5432 on this machine):
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/vision360

# Port the API server listens on (the Vite dev proxy forwards /api here).
PORT=4000

# Only needed for hosted Postgres that requires TLS (Neon / Supabase / RDS):
# PGSSL=true
